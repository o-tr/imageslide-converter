+/// Import raster slides as editable presentation slides, preserving speaker notes.
+fn import_images(app: &mut SlideApp, slides: &JsValue) -> Result<(), String> {
+    let list = js_sys::Array::from(slides);
+    if list.length() == 0 { return Err("No slides to import".into()); }
+    for (index, slide) in list.iter().enumerate() {
+        let field = |key: &str| js_sys::Reflect::get(&slide, &JsValue::from_str(key)).unwrap_or(JsValue::UNDEFINED);
+        let name = field("name").as_string().unwrap_or_else(|| "image.png".into());
+        let note = field("note").as_string().unwrap_or_default();
+        let width = field("width").as_f64().filter(|v| *v > 0.0).ok_or("Invalid image width")?;
+        let height = field("height").as_f64().filter(|v| *v > 0.0).ok_or("Invalid image height")?;
+        let bytes = js_sys::Uint8Array::new(&field("bytes")).to_vec();
+        if index == 0 {
+            let long = width.max(height);
+            let params = serde_json::json!({"w": 720.0 * width / long, "h": 720.0 * height / long, "scale": "none"});
+            app.session.execute("design.slideSize", &params).map_err(|e| e.to_string())?;
+        }
+        app.session.execute("slide.new", &serde_json::json!({"layout": "blank"})).map_err(|e| e.to_string())?;
+        if index == 0 {
+            app.session.execute("slide.delete", &serde_json::json!({"index": 0})).map_err(|e| e.to_string())?;
+        }
+        let size = app.session.active().ok_or("No presentation")?.doc.slide_size;
+        let scale = (size.width / width).min(size.height / height);
+        let w = width * scale;
+        let h = height * scale;
+        let params = serde_json::json!({"name": name, "data": deckcraft_engine::cmd::base64_encode(&bytes), "rect": [(size.width - w)/2.0, (size.height - h)/2.0, w, h]});
+        app.session.execute("insert.picture", &params).map_err(|e| e.to_string())?;
+        app.session.execute("slide.notes", &serde_json::json!({"text": note})).map_err(|e| e.to_string())?;
+    }
+    Ok(())
+}
