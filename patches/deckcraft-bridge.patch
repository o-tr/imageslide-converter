+/// Set the presentation's unspecified default language without rewriting existing runs.
+fn set_default_japanese(session: &mut Session) {
+    let Ok(state) = session.doc_mut() else { return };
+    let document = std::sync::Arc::make_mut(&mut state.doc);
+    let style = &mut document.default_text_style;
+    for index in 0..9 {
+        if style.level(index).is_none() { style.set(index, Default::default()); }
+        if let Some(level) = style.levels.get_mut(index as usize).and_then(Option::as_mut) {
+            if level.run.lang.is_none() { level.run.lang = Some("ja-JP".into()); }
+        }
+    }
+}
