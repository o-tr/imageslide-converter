+<script>
+    // Same-origin parent bridge for ImageSlide Converter.
+    // Fetch only the interface faces from this application's mounted font catalog.
+    window.imageSlideInitialFonts = (async () => {
+      const response = await fetch('/deckcraft-fonts/catalog.json');
+      if (!response.ok) throw new Error('フォント一覧を取得できませんでした');
+      const catalog = await response.json();
+      const select = (families) => {
+        for (const family of families) {
+          const matches = catalog.filter((font) => font.family.toLowerCase() === family.toLowerCase());
+          if (matches.length) return matches.find((font) => /regular|normal|variable/i.test(font.style)) || matches[0];
+        }
+        throw new Error(`必要なフォントがありません: ${families.join(' / ')}`);
+      };
+      const selected = [select(['Inter', 'Noto Sans']), select(['Noto Sans JP', 'BIZ UDPGothic'])];
+      return Promise.all(selected.map(async (font) => {
+        const parts = font.path.split('/'); if (parts[0] !== 'fonts' || parts.some((part) => !part || part === '.' || part === '..' || part.includes('\\'))) throw new Error('不正なフォントパスです'); const result = await fetch(`/deckcraft-fonts/${parts.map(encodeURIComponent).join('/')}`);
+        if (!result.ok) throw new Error(`フォントを読み込めませんでした: ${font.family}`);
+        return new Uint8Array(await result.arrayBuffer());
+      }));
+    })();
+    window.imageSlideQueue = [];
+    const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
+    window.imageSlideQueue.push({ type: 'theme', dark: systemTheme.matches });
+    if (window.parent === window) {
+      systemTheme.addEventListener('change', (event) => window.imageSlideQueue.push({ type: 'theme', dark: event.matches }));
+    }
+    let exporting = false;
+    window.imageSlideSend = (type, name, bytes) => {
+      if (type === 'export-start') exporting = true;
+      if (type === 'image' && !exporting) {
+        const url = URL.createObjectURL(new Blob([bytes]));
+        const a = document.createElement('a');
+        a.href = url;
+        a.download = name;
+        a.click();
+        setTimeout(() => URL.revokeObjectURL(url), 1000);
+        return;
+      }
+      if (type === 'export-end' || type === 'export-error') exporting = false;
+      if (window.parent === window) return;
+      const data = { source: 'deckcraft-poc', type, name, bytes };
+      window.parent.postMessage(data, location.origin, bytes ? [bytes.buffer] : []);
+    };
+    window.addEventListener('message', (event) => {
+      if (event.origin !== location.origin || event.source !== window.parent || event.data?.source !== 'imageslide-poc') return;
+      if (event.data.type === 'open' || event.data.type === 'import-images' || event.data.type === 'export' || event.data.type === 'export-finished' || event.data.type === 'theme') window.imageSlideQueue.push(event.data);
+    });
+    window.imageSlideNext = () => window.imageSlideQueue.shift() ?? null;
+  </script>
 </head>
